# Next.js app (dashboard) — set in EasyPanel on the app service
DATABASE_URL=postgres://user:password@host:5432/panel
# Set to "disable" only if connecting over EasyPanel's internal network without TLS.
PGSSLMODE=require

# scripts/setup-kommo.ts (run once, locally or as a one-off EasyPanel job)
KOMMO_BASE_URL=https://yoursubdomain.kommo.com
KOMMO_API_TOKEN=replace-with-long-lived-token
N8N_WON_LOST_WEBHOOK_URL=https://your-n8n-host/webhook/kommo-won-lost

# Next.js app (dashboard) — server-side only. Lets the "Actualizar" button
# trigger the "Manual run (backfill)" webhook on the kommo-sync-full
# workflow and wait for it to finish before re-reading Postgres.
N8N_SYNC_WEBHOOK_URL=https://your-n8n-host/webhook/kommo-sync-full-manual

# Optional: name hints to locate the campaign/adset/ad fields that already
# exist in the Kommo account (case-insensitive substring match).
KOMMO_CAMPAIGN_FIELD_NAME=campaign
KOMMO_ADSET_FIELD_NAME=adset
KOMMO_AD_FIELD_NAME=ad

# n8n instance — set these as environment variables on the n8n instance
# itself (Settings > Variables, or the container's env), NOT in this file.
# The two workflows in n8n/ read them via $env.*:
#   KOMMO_BASE_URL
#   KOMMO_API_TOKEN
#   KOMMO_FIELD_AGENDA_ID
#   KOMMO_FIELD_CITA_ASISTIDA_ID
#   KOMMO_FIELD_COTIZACION_ID
#   KOMMO_FIELD_CAMPAIGN_ID
#   KOMMO_FIELD_ADSET_ID
#   KOMMO_FIELD_AD_ID
# (values come out of n8n/field-map.generated.json after running setup-kommo.ts)
